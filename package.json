{
  "name": "@railprint/monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm font fetch && pnpm --filter @railprint/web build",
    "dev": "pnpm --filter @railprint/web dev",
    "test": "pnpm -r test",
    "check": "rs check --type-check",
    "format": "rs fmt",
    "prepare": "rs hooks",
    "sources": "node packages/sources/src/cli.ts",
    "catalog": "node packages/catalog/src/cli.ts",
    "osm": "node packages/osm/src/cli.ts",
    "match": "node packages/matching/src/cli.ts",
    "release": "node packages/release/src/cli.ts",
    "basemap": "node packages/basemap/src/cli.ts",
    "export": "node packages/export/src/cli.ts",
    "font": "node packages/font/src/cli.ts",
    "tiles": "pnpm --filter @railprint/tiles build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rstack": "catalog:"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  }
}
